<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_滿足"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp"
    app:strokeColor="#e2e2e7"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#ffffff"
    android:theme="@style/Theme.MaterialComponents.Light">

    <!-- For layout width, match_parent is used, but wait, the Chinese character "match_滿足" should be "match_parent" -->
    <!-- Let's fix that typo. Yes, match_parent is match_parent in Android XML! -->
    <!-- Let's write it carefully with match_parent. -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Clinic Title & Doctor -->
        <TextView
            android:id="@+id/tv_clinic_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="General OPD"
            android:textColor="#00284b"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_status_badge"/>

        <TextView
            android:id="@+id/tv_doctor_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dr. Phiri"
            android:textColor="#556158"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_clinic_name"/>

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_badge_active"
            android:textColor="#3e4a41"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Queue Stats Grid Container -->
        <LinearLayout
            android:id="@+id/layout_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:weightSum="3"
            android:background="#f8f9ff"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_doctor_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Stats: In Queue -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IN QUEUE"
                    android:textColor="#727780"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_queue_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18"
                    android:textColor="#00284b"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Stats: Serving Token -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT"
                    android:textColor="#727780"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_serving_token"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A-024"
                    android:textColor="#14487a"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="#d2e4ff"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Stats: Next Token -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NEXT"
                    android:textColor="#727780"
                    android:textSize="10sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_next_token"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A-025"
                    android:textColor="#42474f"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/layout_stats"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <Button
                android:id="@+id/btn_call_next"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Call Next"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:backgroundTint="#00284b"
                android:textColor="#ffffff"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp"/>

            <Button
                android:id="@+id/btn_toggle_status"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Pause"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#42474f"
                app:strokeColor="#727780"
                app:strokeWidth="1dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="8dp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
