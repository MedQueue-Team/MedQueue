<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Premium Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_container"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/primary"
        app:title="Medical Records"
        app:titleTextColor="@color/on_surface"
        app:elevation="2dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Breadcrumb Navigation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Triage › Medical Records"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <!-- Patient Profile Header -->
            <TextView
                android:id="@+id/txtPatientName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Amara Okafor"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/txtPatientInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="ID: LSK-KNH-004582 • 34 Years • Female"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant" />

            <!-- Quick Vitals Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_container_lowest">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:orientation="horizontal">

                    <!-- Blood Pressure -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BP"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/txtBP"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="120/80"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/outline_variant" />

                    <!-- Heart Rate -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HR"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/txtHR"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72 bpm"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/outline_variant" />

                    <!-- SpO2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SpO2"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/txtSpO2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="98%"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/outline_variant" />

                    <!-- Temperature -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Temp"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/txtTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="36.8°C"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Search Bar -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                app:boxBackgroundColor="@color/surface_container_lowest"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="@color/outline_variant"
                app:boxStrokeWidth="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/on_surface_variant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search medical events, diagnoses..."
                    android:inputType="text"
                    android:paddingVertical="12dp"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Horizontal Categories Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="All Records"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/chip_selected"
                        android:textColor="@color/white"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipConsultations"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Consultations"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/chip_unselected"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipLabResults"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Lab Results"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/chip_unselected"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipVaccinations"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Vaccinations"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/chip_unselected"
                        android:textColor="@color/on_surface_variant"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/chipMedications"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Medications"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/chip_unselected"
                        android:textColor="@color/on_surface_variant"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Encounters Timeline Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENCOUNTER TIMELINE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/outline"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEncounters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_medical_encounter" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
