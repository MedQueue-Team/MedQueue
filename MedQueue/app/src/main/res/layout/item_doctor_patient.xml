<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_card_surface"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No."
                android:textSize="10sp"
                android:textColor="@color/primary"
                android:textAllCaps="true" />
            <TextView
                android:id="@+id/tv_queue_no"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A-12"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_patient_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Elena Rodriguez"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface" />
                <TextView
                    android:id="@+id/tv_priority_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="EMERGENCY"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_tag_urgent"
                    android:textColor="@color/error" />
            </RelativeLayout>
            <TextView
                android:id="@+id/tv_dept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General Medicine"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="2dp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@color/primary"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:id="@+id/tv_wait_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waiting (08m)"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btn_call_patient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Call Patient"
            android:textSize="12sp"
            android:textColor="@color/on_primary"
            android:backgroundTint="@color/primary"
            app:cornerRadius="8dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
