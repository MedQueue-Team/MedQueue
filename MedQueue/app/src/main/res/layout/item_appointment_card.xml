<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_container_lowest">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Doctor Avatar -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDocPhoto"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_gallery"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_toEndOf="@id/ivDocPhoto"
                android:layout_toStartOf="@id/tvCardStatus"
                android:layout_marginStart="12dp"
                android:layout_centerVertical="true">

                <TextView
                    android:id="@+id/tvDocName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dr. Sarah Jenkins"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDocSpecialty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cardiology Specialist"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Status tag -->
            <TextView
                android:id="@+id/tvCardStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Approved"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_tag_approved"
                android:textColor="@color/on_secondary_container"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_variant"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Date & Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar_month"
                app:tint="@color/on_primary_fixed_variant"
                android:layout_gravity="center_vertical" />

            <TextView
                android:id="@+id/tvCardDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuesday, Oct 19, 2023"
                android:textColor="@color/on_primary_fixed_variant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_dot_progress"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp" />

            <TextView
                android:id="@+id/tvCardTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00 AM"
                android:textColor="@color/on_primary_fixed_variant"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- Reason / Comments -->
        <TextView
            android:id="@+id/tvCardReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reason: General wellness heart cardiology consultation."
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:layout_marginBottom="12dp" />

        <!-- Warning banner (only visible if rejected) -->
        <TextView
            android:id="@+id/tvWarningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/error_container"
            android:textColor="@color/on_error_container"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:text="Clinic capacity reached. Please reschedule or call support."
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Bottom Action Row -->
        <Button
            android:id="@+id/btnCardAction"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Ready for Visit"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white"
            app:cornerRadius="10dp"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
