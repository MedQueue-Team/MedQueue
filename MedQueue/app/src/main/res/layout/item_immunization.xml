<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/icon_vax_container"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:cardBackgroundColor="@color/secondary"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/vax_status_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check"
            app:tint="@color/on_secondary" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/icon_vax_container"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vax_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vaccine Name"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vax_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manufacturer • Date"
            android:textColor="@color/on_surface_variant"
            android:textSize="11sp" />
    </LinearLayout>

</RelativeLayout>
