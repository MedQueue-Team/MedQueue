<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top App Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@color/surface"
                android:paddingHorizontal="16dp"
                android:elevation="4dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/btn_back"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/primary"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Medical Records"
                        android:textColor="@color/primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/btn_profile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_account_circle" />
            </RelativeLayout>

            <!-- Patient Summary Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:id="@+id/iv_patient_photo"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_person"
                        android:background="@drawable/bg_card_surface"
                        android:scaleType="centerCrop" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:id="@+id/tv_patient_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Amara Okafor"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                        <TextView
                            android:id="@+id/tv_patient_info"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="34Y, Female • O+ Positive"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant" />
                        <TextView
                            android:id="@+id/tv_patient_id"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Patient ID: MQ-8821"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            <!-- Search & Filter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">
                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Search records..."
                    android:background="@drawable/bg_card_surface"
                    android:paddingLeft="12dp"
                    android:textSize="14sp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/filter_all"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="All"
                            android:backgroundTint="@color/primary"
                            android:textColor="@color/on_primary"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp"
                            app:cornerRadius="18dp" />
                        <Button
                            android:id="@+id/filter_diagnoses"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Diagnoses"
                            android:backgroundTint="@color/surface_container_high"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp"
                            app:cornerRadius="18dp" />
                        <Button
                            android:id="@+id/filter_prescriptions"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Prescriptions"
                            android:backgroundTint="@color/surface_container_high"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp"
                            app:cornerRadius="18dp" />
                        <Button
                            android:id="@+id/filter_consultations"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Consultations"
                            android:backgroundTint="@color/surface_container_high"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            app:cornerRadius="18dp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Records List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_records"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
