<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Greeting Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/ivProfileAvatar">

                    <TextView
                        android:id="@+id/tvGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good Morning, Amara"
                        android:textColor="@color/primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSubGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="October 25, 2023 • Patient Portal"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnNotifications"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_notifications"
                    android:layout_toStartOf="@id/ivProfileAvatar"
                    android:layout_marginEnd="12dp"
                    android:layout_centerVertical="true"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    contentDescription="Notifications" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery"
                    app:shapeAppearanceOverlay="@style/CircleImage" />
            </RelativeLayout>

            <!-- Bento Asymmetric Stats Summary Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="24dp"
                android:weightSum="3">

                <!-- Stats 1: Appointments -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStatAppts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/primary_fixed">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_calendar_month"
                            app:tint="@color/on_primary_fixed_variant"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="02 Appts"
                            android:textColor="@color/on_primary_fixed"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Next: 09:15 AM"
                            android:textColor="@color/on_primary_fixed_variant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Stats 2: Queue Status -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStatQueue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/secondary_container">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_confirmation_number"
                            app:tint="@color/on_secondary_container"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pos. #4"
                            android:textColor="@color/on_secondary_fixed"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wait: 12 min"
                            android:textColor="@color/on_secondary_container"
                            android:textSize="11sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Stats 3: Medical Records -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStatRecords"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/tertiary_fixed">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_folder_shared"
                            app:tint="@color/on_tertiary_fixed_variant"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12 History"
                            android:textColor="@color/on_tertiary_fixed"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last: Oct 12"
                            android:textColor="@color/on_tertiary_fixed_variant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- Live Queue Status Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLiveQueue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/primary">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <View
                        android:id="@+id/pulseDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_status_dot_progress"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvQueueDept" />

                    <TextView
                        android:id="@+id/tvQueueTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE QUEUE TRACKER"
                        android:textColor="@color/on_primary_container"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1"
                        android:layout_marginStart="8dp"
                        app:layout_constraintStart_toEndOf="@id/pulseDot"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/tvQueueDept" />

                    <TextView
                        android:id="@+id/tvQueueDept"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cardiology Dept"
                        android:textColor="@color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/pulseDot" />

                    <TextView
                        android:id="@+id/tvQueueNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ticket #102"
                        android:textColor="@color/primary_fixed"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvQueueDept"
                        app:layout_constraintBottom_toBottomOf="@id/tvQueueDept" />

                    <ProgressBar
                        android:id="@+id/pbQueueProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progress="65"
                        android:progressDrawable="@drawable/bg_progress_primary"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/tvQueueDept" />

                    <TextView
                        android:id="@+id/tvQueuePosition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 patients ahead of you"
                        android:textColor="@color/on_primary_container"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/pbQueueProgress" />

                    <TextView
                        android:id="@+id/tvQueueWait"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Est: 12 mins"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tvQueuePosition"
                        app:layout_constraintBottom_toBottomOf="@id/tvQueuePosition" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Please remain near Room Cardiology A-102. You are next up."
                        android:textColor="@color/on_primary_container"
                        android:textSize="11sp"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/tvQueuePosition" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Action Row -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Book Appointment Action -->
                    <Button
                        android:id="@+id/btnQuickBook"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Book Consult"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/primary"
                        app:icon="@drawable/ic_add"
                        app:iconTint="@color/white"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="24dp"
                        android:paddingHorizontal="16dp" />

                    <!-- View Records Action -->
                    <Button
                        android:id="@+id/btnQuickRecords"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View Records"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/primary"
                        app:icon="@drawable/ic_medical_information"
                        app:iconTint="@color/primary"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="24dp"
                        android:paddingHorizontal="16dp" />

                    <!-- Join Queue Action -->
                    <Button
                        android:id="@+id/btnQuickQueue"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Join Queue"
                        android:textColor="@color/on_secondary_container"
                        android:backgroundTint="@color/secondary_container"
                        app:icon="@drawable/ic_confirmation_number"
                        app:iconTint="@color/on_secondary_container"
                        app:cornerRadius="24dp"
                        android:paddingHorizontal="16dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Upcoming Appointments Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Visits"
                    android:textColor="@color/primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true" />

                <TextView
                    android:id="@+id/btnViewAllAppts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All"
                    android:textColor="@color/on_primary_fixed_variant"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </RelativeLayout>

            <!-- List container for Appointments -->
            <LinearLayout
                android:id="@+id/llAppointmentsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />

            <!-- Recent Records Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recent Medical Record"
                    android:textColor="@color/primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_alignParentStart="true" />

                <TextView
                    android:id="@+id/btnViewFullHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Full History"
                    android:textColor="@color/on_primary_fixed_variant"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_alignParentEnd="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </RelativeLayout>

            <!-- Recent Record Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRecentRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvRecordDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="October 12, 2023"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:layout_alignParentStart="true" />

                        <TextView
                            android:id="@+id/tvRecordDoctor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dr. Elena Rodriguez"
                            android:textColor="@color/primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_alignParentEnd="true" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvRecordDiagnosis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acute Bronchitis"
                        android:textColor="@color/primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvRecordTreatment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Treatment: Amoxicillin 500mg (3x daily, 7 days course)"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button for Booking -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabBookAppointment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:src="@drawable/ic_add"
        app:tint="@color/white"
        app:backgroundTint="@color/primary"
        contentDescription="Book New Appointment" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
